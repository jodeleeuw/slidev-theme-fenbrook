{
  "name": "slidev-theme-fenbrook",
  "version": "0.1.0",
  "description": "Warm-dark Slidev theme with diagram, gallery, and annotation components.",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "license": "MIT",
  "author": "Josh de Leeuw",
  "repository": "github:jodeleeuw/slidev-theme-fenbrook",
  "packageManager": "pnpm@11.5.0",
  "files": [
    "components",
    "layouts",
    "setup",
    "styles",
    "utils",
    "global-top.vue"
  ],
  "scripts": {
    "dev": "slidev demo/slides.md",
    "build": "slidev build demo/slides.md",
    "export": "slidev export demo/slides.md",
    "lint": "eslint ."
  },
  "engines": {
    "slidev": ">=0.48.0"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "slidev": {
    "colorSchema": "dark",
    "defaults": {
      "highlighter": "shiki",
      "fonts": {
        "sans": "Inter",
        "serif": "Fraunces",
        "mono": "JetBrains Mono",
        "weights": "300,400,500,600,700",
        "italic": true
      },
      "themeConfig": {
        "course": "",
        "event": "",
        "accentIcons": ""
      }
    }
  }
}
